# ==============================================================================
# DOVE Backend Environment Configuration (Local Development)
# Note: Authentication is disabled for local development per specification.
# ==============================================================================

# Application
APP_NAME=DOVE Backend
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Database Configuration (PostgreSQL + pgvector)
# For docker-compose: postgresql+psycopg://dove_user:dove_password@db:5432/dove_db
# For local fallback/testing: sqlite+aiosqlite:///./dove.db or postgresql+psycopg://...
DATABASE_URL=postgresql+psycopg://dove_user:dove_password@localhost:5432/dove_db

# MQTT Configuration (Eclipse Mosquitto)
# Local development allows anonymous connections without credentials
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_KEEPALIVE=60
MQTT_CLIENT_ID=dove-backend-worker

# Groq LLM API Configuration
GROQ_API_KEY=gsk_placeholder_replace_with_actual_key
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_TEMPERATURE=0.7
GROQ_MAX_TOKENS=300
GROQ_TIMEOUT_SECONDS=15.0

# Embedding Configuration for RAG / Long-Term Memory
# Options: "local" (fast lightweight hash/projection), "groq" (if supported), or "mock"
EMBEDDING_PROVIDER=local
EMBEDDING_DIMENSION=384

# Proactive Interaction Engine Settings
PROACTIVE_COOLDOWN_MINUTES=30
PROACTIVE_ENABLED_DEFAULT=true
QUIET_HOURS_START_DEFAULT=22:00
QUIET_HOURS_END_DEFAULT=07:00
USER_TIMEZONE_DEFAULT=Asia/Kolkata

# Mood Trigger Engine Settings
MOOD_MAX_EVENT_GAP_SECONDS=150
MOOD_EVENT_MAX_AGE_SECONDS=1800

# Docker/LAN: set BIND_HOST=0.0.0.0 so the Dove device can reach the MQTT broker (1883) and the API/voice
# WebSocket (8000). Default 127.0.0.1 keeps both private to this machine. Dev auth is OFF: use only on a trusted network.
# BIND_HOST=0.0.0.0

# Process roles (see docker-compose.yml: the API is publish-only, the worker owns MQTT consumption + the planner)
MQTT_SUBSCRIBE=true
RUN_SCHEDULER=true

# Stress session planner (presence-based)
STRESS_DAILY_TARGET=3
STRESS_DAY_START=09:00
STRESS_DAY_END=21:00
STRESS_MIN_GAP_MINUTES=120
STRESS_CATCHUP_GAP_MINUTES=20
STRESS_RETRY_MINUTES=15
STRESS_PRESENCE_SETTLE_SECONDS=60
STRESS_SESSION_TIMEOUT_MINUTES=10
